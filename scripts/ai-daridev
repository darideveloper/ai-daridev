#!/usr/bin/env bash
# ai-daridev — deterministic setup, preflight and diagnostics.
set -euo pipefail
SELF="$(readlink -f "$0")"
LIB="$(cd "$(dirname "$SELF")" && pwd)/lib"
cmd="${1:-}"; shift || true

case "$cmd" in
  preflight) python3 "$LIB/preflight.py" "$@" ;;
  init)      python3 "$LIB/init_repo.py" "$@" ;;
  uid)       python3 "$LIB/set_uid.py" "$@" ;;
  setup)     python3 "$LIB/setup.py" "$@" ;;
  doctor)
    python3 "$LIB/preflight.py" "$@"; rc=$?
    echo "---"
    engram doctor || rc=1
    exit $rc
    ;;
  upgrade)   exec "$(dirname "$LIB")/install.sh" ;;
  ""|-h|--help)
    cat <<'EOF'
usage: ai-daridev <command>

  init [--project NAME] [--uid N] [--no-odoo] [--force] [--dry-run]
                     write the AGENTS.md block (owner, once per repo)
  uid <n>            set your personal Odoo uid (never committed)
  preflight          validate config + resolve ids; JSON on stdout
  doctor             preflight + engram doctor, human output
  setup [--dry-run|--print|--restore]
                     install/upgrade Engram, link skills, apply MCP + instructions
  upgrade            reinstall the pinned Engram version
EOF
    exit 2
    ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
